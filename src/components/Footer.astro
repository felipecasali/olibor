---
import site from '../data/site.json';
import produtos from '../data/produtos.json';
const e = site.empresa;
const ano = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container site-footer__grid">
    <div>
      <a href="/" class="site-footer__brand" aria-label="Olibor — página inicial">
        <img src="/img/logo-olibor.png" alt="Olibor" width="53" height="50" loading="lazy" />
      </a>
      <p class="site-footer__about">Fabricante de vedadores e peças técnicas de borracha desde {e.fundacao}. Sob especificação, amostra ou desenho.</p>
      <span class="badge badge--green">{e.certificacao}</span>
    </div>
    <div>
      <h2 class="site-footer__title">Produtos</h2>
      <ul>{produtos.map((p) => <li><a href={`/produtos/${p.slug}`}>{p.titulo}</a></li>)}</ul>
    </div>
    <div>
      <h2 class="site-footer__title">Institucional</h2>
      <ul>{site.nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
    </div>
    <div>
      <h2 class="site-footer__title">Contato</h2>
      <address>
        {e.endereco.rua}<br />
        {e.endereco.bairro} — {e.endereco.cidade}/{e.endereco.uf}<br />
        CEP {e.endereco.cep}
      </address>
      <p>
        {e.telefones.map((t, i) => <><a href={`tel:+55${t.replace(/\D/g, '')}`}>{t}</a>{i < e.telefones.length - 1 && <br />}</>)}<br />
        <a href={`mailto:${e.email}`}>{e.email}</a>
      </p>
      <p class="site-footer__hours">{e.horario}</p>
    </div>
  </div>
  <div class="container site-footer__base">
    <span>© {ano} {e.razaoSocial}</span>
    <span class="site-footer__links">
      <a href="/privacidade">Privacidade</a>
      <button type="button" class="motion-toggle" data-motion-toggle aria-pressed="true">Animações: ligadas</button>
    </span>
  </div>
</footer>

<style>
  .site-footer { background: var(--surface-inverse-deep); color: rgba(255,255,255,.78); font-size: var(--fs-sm); padding-top: var(--space-16); }
  .site-footer__grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1.3fr; gap: var(--space-10); padding-bottom: var(--space-12); }
  .site-footer__brand img { height: 50px; width: auto; }
  .site-footer__about { margin: var(--space-5) 0; max-width: 34ch; }
  .site-footer__title { font-family: var(--font-condensed); font-size: var(--fs-eyebrow); font-weight: 700; letter-spacing: var(--ls-eyebrow); text-transform: uppercase; color: #fff; margin-bottom: var(--space-4); }
  .site-footer ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); }
  .site-footer a { color: rgba(255,255,255,.82); }
  .site-footer a:hover { color: #fff; }
  .site-footer address { font-style: normal; margin-bottom: var(--space-4); }
  .site-footer__hours { color: rgba(255,255,255,.62); }
  .site-footer__base { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-4); padding-top: var(--space-6); padding-bottom: var(--space-6); border-top: 1px solid var(--border-inverse); color: rgba(255,255,255,.6); font-size: var(--fs-xs); }
  .site-footer__links { display: flex; gap: var(--space-6); align-items: center; }
  .motion-toggle { background: none; border: 0; padding: 0; font: inherit; color: rgba(255,255,255,.72); cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
  .motion-toggle:hover { color: #fff; }
  @media (max-width: 900px) { .site-footer__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .site-footer__grid { grid-template-columns: 1fr; } }
</style>
