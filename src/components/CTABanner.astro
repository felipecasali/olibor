---
interface Props { title: string; text?: string; href?: string; label?: string; }
const { title, text, href = '/contato#orcamento', label = 'Solicitar orçamento' } = Astro.props;
---
<section class="section--tight cta-wrap">
  <div class="container">
    <div class="cta" data-reveal>
      <div>
        <h2>{title}</h2>
        {text && <p>{text}</p>}
      </div>
      <a class="btn btn--accent btn--lg" href={href}>{label}</a>
    </div>
  </div>
</section>
<style>
  .cta { background: var(--surface-inverse); border-radius: var(--radius-md); padding: var(--space-10) var(--space-12); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-8); }
  .cta h2 { color: #fff; font-size: clamp(26px, 2.6vw, 36px); }
  .cta p { color: rgba(255,255,255,.8); margin: var(--space-3) 0 0; font-size: var(--fs-lead); max-width: 52ch; }
  @media (max-width: 600px) { .cta { padding: var(--space-8) var(--space-6); } }
</style>
