---
import site from '../data/site.json';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="site-header" data-header>
  <div class="container site-header__bar">
    <a href="/" class="brand" aria-label="Olibor — página inicial">
      <img src="/img/logo-olibor.png" alt="Olibor" width="47" height="44" />
      <span class="brand__tag">Borrachas e Retentores</span>
    </a>
    <nav class="main-nav" aria-label="Principal" id="main-nav">
      <ul>
        {site.nav.map((item) => (
          <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
      <a href="/contato#orcamento" class="btn btn--accent main-nav__cta">Orçamento</a>
    </nav>
    <button class="menu-toggle" aria-expanded="false" aria-controls="main-nav" data-menu-toggle>
      <span class="sr-only">Abrir menu</span>
      <span class="menu-toggle__bars" aria-hidden="true"></span>
    </button>
  </div>
  <div class="site-header__progress" aria-hidden="true"><span data-progress></span></div>
</header>

<style>
  .site-header {
    position: fixed; inset: 0 0 auto 0; z-index: 50;
    background: var(--surface-inverse); border-bottom: 1px solid rgba(255,255,255,.14);
    transition: box-shadow 240ms var(--ease-standard);
  }
  .site-header.is-compact { box-shadow: 0 6px 24px rgba(0,0,0,.18); }
  .site-header__bar { display: flex; align-items: center; gap: var(--space-8); height: var(--header-h); transition: height 240ms var(--ease-standard); }
  .site-header.is-compact .site-header__bar { height: var(--header-h-compact); }
  .brand { display: flex; align-items: center; gap: var(--space-3); text-decoration: none; flex-shrink: 0; }
  .brand:hover { text-decoration: none; }
  .brand img { height: 44px; width: auto; transition: height 240ms var(--ease-standard); }
  .site-header.is-compact .brand img { height: 36px; }
  .brand__tag { font-family: var(--font-condensed); font-size: 12px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; color: rgba(255,255,255,.62); line-height: 1.3; max-width: 96px; }

  .main-nav { margin-left: auto; display: flex; align-items: center; gap: var(--space-8); }
  .main-nav ul { display: flex; gap: 26px; list-style: none; margin: 0; padding: 0; }
  .main-nav ul a {
    font-family: var(--font-condensed); font-size: var(--fs-sm); font-weight: 600; letter-spacing: var(--ls-button);
    text-transform: uppercase; color: rgba(255,255,255,.86); padding: 6px 0; border-bottom: 2px solid transparent;
    transition: color var(--dur-fast), border-color var(--dur-fast);
  }
  .main-nav ul a:hover { color: #fff; text-decoration: none; border-bottom-color: var(--color-accent); }
  .main-nav ul a[aria-current="page"] { color: #fff; border-bottom-color: var(--color-accent); }
  .main-nav__cta { padding: 12px 22px; }

  .menu-toggle { display: none; margin-left: auto; width: 44px; height: 44px; background: transparent; border: 1px solid var(--border-inverse); border-radius: var(--radius-sm); cursor: pointer; position: relative; }
  .menu-toggle__bars, .menu-toggle__bars::before, .menu-toggle__bars::after { position: absolute; left: 11px; width: 20px; height: 2px; background: #fff; content: ""; transition: transform 200ms var(--ease-standard), opacity 120ms; }
  .menu-toggle__bars { top: 20px; }
  .menu-toggle__bars::before { left: 0; top: -6px; }
  .menu-toggle__bars::after { left: 0; top: 6px; }
  .menu-toggle[aria-expanded="true"] .menu-toggle__bars { background: transparent; }
  .menu-toggle[aria-expanded="true"] .menu-toggle__bars::before { transform: translateY(6px) rotate(45deg); }
  .menu-toggle[aria-expanded="true"] .menu-toggle__bars::after { transform: translateY(-6px) rotate(-45deg); }

  .site-header__progress { height: 2px; background: rgba(255,255,255,.08); }
  .site-header__progress span { display: block; height: 2px; width: 0; background: var(--color-accent); }

  @media (max-width: 1060px) {
    .menu-toggle { display: block; }
    .main-nav {
      position: fixed; inset: var(--header-h) 0 auto 0; background: var(--olibor-green-900);
      flex-direction: column; align-items: stretch; gap: var(--space-6); padding: var(--space-6) var(--gutter) var(--space-8);
      border-top: 1px solid rgba(255,255,255,.12); display: none; max-height: calc(100vh - var(--header-h)); overflow-y: auto;
    }
    .site-header.is-compact .main-nav { inset: var(--header-h-compact) 0 auto 0; }
    .main-nav.is-open { display: flex; }
    .main-nav ul { flex-direction: column; gap: 0; }
    .main-nav ul a { display: block; padding: 14px 0; font-size: var(--fs-body); border-bottom: 1px solid rgba(255,255,255,.1); }
    .main-nav ul a[aria-current="page"] { color: var(--olibor-sand-100); border-bottom-color: rgba(255,255,255,.1); }
    .main-nav__cta { align-self: flex-start; }
  }
</style>
