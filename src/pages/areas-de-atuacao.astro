---
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import CTABanner from '../components/CTABanner.astro';
import site from '../data/site.json';
---
<Base title="Áreas de atuação" description="A Olibor atende petróleo e gás, metalúrgica, máquinas pesadas, manutenção, farmacêutica, vedação industrial, bebidas, saneamento e agricultura.">
  <PageBanner title="Áreas de atuação" trail={[{ label: 'Áreas de atuação' }]} lead="Atendemos diversos segmentos industriais com soluções de vedação para máquinas, equipamentos, sistemas pressurizados e outros." />

  <section class="section">
    <div class="container">
      <ul class="areas-grid">
        {site.areas.map((a, i) => (
          <li data-reveal>
            <img src={`/img/areas/${a.foto}-640.webp`} srcset={`/img/areas/${a.foto}-640.webp 640w, /img/areas/${a.foto}.webp 1200w`} sizes="(max-width: 700px) 100vw, 400px" alt={a.alt} width="640" height="427" loading="lazy" decoding="async" />
            <div class="areas-grid__label">
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <h2>{a.nome}</h2>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CTABanner title="Seu segmento não está na lista?" text="Desenvolvemos vedadores para máquinas e equipamentos em geral. Consulte-nos." />
</Base>
<style>
  .areas-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: var(--space-6); }
  .areas-grid li { background: var(--surface-card); border: 1px solid var(--border-hairline); border-radius: var(--radius-md); box-shadow: var(--shadow-card); overflow: hidden; transition: transform var(--dur-base) var(--ease-standard), box-shadow var(--dur-base) var(--ease-standard); }
  .areas-grid li:hover { transform: translateY(-3px); box-shadow: var(--shadow-card-hover); }
  .areas-grid img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; filter: saturate(.85); }
  .areas-grid__label { display: flex; align-items: baseline; gap: var(--space-4); padding: var(--space-5) var(--space-6); }
  .areas-grid span { font-family: var(--font-condensed); font-weight: 700; color: var(--color-accent); letter-spacing: .06em; }
  .areas-grid h2 { font-size: clamp(24px, 2.2vw, 30px); text-transform: uppercase; letter-spacing: .01em; }
</style>
